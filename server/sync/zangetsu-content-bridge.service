[Unit]
Description=Temporary Zangetsu content bridge during VPS sync rollout
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=zangetsu_bridge
Group=zangetsu_bridge
WorkingDirectory=/opt/zangetsu-content
Environment=SUPABASE_DSN_FILE=/etc/zangetsu/supabase-db-url
Environment=HOME=/var/empty
Environment="VPS_DSN=dbname=zangetsu_sync_stage user=zangetsu_bridge"
ExecStart=/usr/bin/python3 /opt/zangetsu-content/content_bridge.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
